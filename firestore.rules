rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profiles and nested subcollections (e.g. learning_profile/twin)
    match /users/{userId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Generated & Saved Courses
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Quiz Attempts & Diagnostics
    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }

    // 7-Day Fix My Learning Recovery Plans
    match /recovery_plans/{planId} {
      allow read, write: if true;
    }

    // AI Tutor History
    match /tutor_chats/{chatId} {
      allow read, write: if true;
    }

    // User Learning Tasks & Offline Sync Queue
    match /tasks/{taskId} {
      allow read, write: if true;
    }
  }
}
